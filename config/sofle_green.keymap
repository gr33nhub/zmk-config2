/* #include <behaviors.dtsi> */
/* #include <dt-bindings/zmk/bt.h> */
/* #include <dt-bindings/zmk/keys.h> */
/**/
/* / { */
/*     keymap { */
/*         compatible = "zmk,keymap"; */
/**/
/*         default_layer { */
/*             bindings = < */
/* &kp GRAVE       &mt LG(NUMBER_1) NUMBER_1  &mt LG(NUMBER_2) NUMBER_2  &mt LG(NUMBER_3) NUMBER_3  &mt LG(NUMBER_4) NUMBER_4  &mt LG(NUMBER_5) NUMBER_5                     &mt LG(NUMBER_6) NUMBER_6  &mt LG(NUMBER_7) NUMBER_7  &mt LG(NUMBER_8) NUMBER_8  &mt LG(NUMBER_9) NUMBER_9  &mt LG(NUMBER_0) NUMBER_0  &none */
/* &lt 2 TAB       &kp Q                      &kp W                      &kp E                      &kp R                      &kp T                                         &kp Y                      &kp U                      &kp I                      &kp O                      &kp P                      &kp SQT */
/* &mt LSHIFT ESC  &mt LEFT_GUI A             &mt LEFT_ALT S             &mt LEFT_CONTROL D         &mt LEFT_SHIFT F           &kp G                                         &kp H                      &mt RIGHT_SHIFT J          &mt RIGHT_CONTROL K        &mt RIGHT_ALT L            &mt RIGHT_GUI COLON        &kp BSPC */
/* &kp LCTRL       &kp Z                      &kp X                      &kp C                      &kp V                      &kp B                      &kp C_MUTE  &none  &kp N                      &kp M                      &mt QMARK COMMA            &mt EXCL DOT               &mt SLASH FSLH             &kp RSHFT */
/*                                            &mt LGUI SPACE             &kp LALT                   &kp LCTRL                  &mo 1                      &lt 2 RET   &mo 1  &kp SPACE                  &kp RCTRL                  &kp RALT                   &kp RGUI */
/*             >; */
/**/
/*             sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>; */
/*         }; */
/**/
/*         lower_layer { */
/*             bindings = < */
/* &trans    &mt LG(LS(NUMBER_1)) LG(LS(LA(NUMBER_1)))  &mt LG(LS(NUMBER_2)) LG(LS(LA(NUMBER_2)))  &mt LG(LS(NUMBER_3)) LG(LS(LA(NUMBER_3)))  &mt LG(LS(NUMBER_4)) LG(LS(LA(NUMBER_4)))  &mt LG(LS(NUMBER_5)) LG(LS(LA(NUMBER_5)))                    &mt LG(LS(NUMBER_6)) LG(LS(LA(NUMBER_6)))  &mt LG(LS(NUMBER_7)) LG(LS(LA(NUMBER_7)))  &mt LG(LS(NUMBER_8)) LG(LS(LA(NUMBER_8)))  &mt LG(LS(NUMBER_9)) LG(LS(LA(NUMBER_9)))  &mt LG(LS(NUMBER_0)) LG(LS(LA(NUMBER_0)))  &trans */
/* &trans    &kp GRAVE                                  &kp N1                                     &kp N2                                     &kp N3                                     &kp N4                                                       &kp N5                                     &kp N6                                     &kp N7                                     &kp N8                                     &kp N9                                     &kp N0 */
/* &kp F12   &trans                                     &kp EXCL                                   &kp AT                                     &kp HASH                                   &kp DLLR                                                     &kp PRCNT                                  &kp CARET                                  &kp AMPS                                   &kp KP_MULTIPLY                            &kp LPAR                                   &kp RPAR */
/* &kp PIPE  &trans                                     &kp EQUAL                                  &kp MINUS                                  &kp KP_PLUS                                &kp LBRC                                   &kp RBRC  &trans  &trans                                     &kp LBKT                                   &kp RBKT                                   &kp SEMI                                   &kp COLON                                  &kp BSLH */
/*                                                      &trans                                     &trans                                     &trans                                     &trans                                     &trans    &trans  &trans                                     &trans                                     &trans                                     &trans */
/*             >; */
/**/
/*             sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>; */
/*         }; */
/**/
/*         raise_layer { */
/*             bindings = < */
/* &bt BT_CLR                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &trans     &trans    &trans    &trans     &trans   &trans */
/* &mt LG(LS(NUMBER_1)) LG(LS(LA(NUMBER_1)))  &trans        &trans        &trans        &trans        &trans                        &kp PG_UP  &trans    &kp UP    &trans     &trans   &trans */
/* &trans                                     &kp LALT      &kp LCTRL     &kp LSHFT     &trans        &kp CLCK                      &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC */
/* &studio_unlock                             &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &trans        &trans  &trans  &trans     &trans    &trans    &trans     &trans   &trans */
/*                                                          &trans        &trans        &trans        &trans        &trans  &trans  &trans     &trans    &trans    &trans */
/*             >; */
/**/
/*             sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>; */
/*         }; */
/*     }; */
/* }; */
/**/

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp GRAVE       &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                         &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &none
&lt 2 TAB       &kp Q        &kp W        &kp E        &kp R        &kp T                          &kp Y        &kp U        &kp I        &kp O        &kp P        &kp SQT
&kp ESC         &kp A        &kp S        &kp D        &kp F        &kp G                          &kp H        &kp J        &kp K        &kp L        &kp O       &kp BACKSPACE
&kp LSHIFT      &kp Z        &kp X        &kp C        &kp V        &kp B          &kp C_MUTE &none &kp N   &kp M        &kp COMMA    &kp DOT      &kp SLASH   &kp RSHIFT
                                      &kp LGUI     &kp LCTRL    &kp ENTER    &mo 1    &kp ESC      &kp RCTRL   &kp SPACE   &kp BACKSPACE &kp RALT   &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };


        lower_layer {
            bindings = <
&trans      &kp F1       &kp F2       &kp F3       &kp F4       &kp F5                         &kp F6       &kp F7       &kp F8       &kp F9       &kp F10      &trans

&trans      &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                         &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &trans

&trans      &kp RA(Q)    &kp RA(N7)   &kp RA(N8)   &kp RA(N9)   &kp RA(N0)                     &kp RA(N7)   &kp RA(N8)   &kp RA(N9)   &kp RA(N0)   &kp RA(S)   &trans

&trans      &kp RA(SLSH) &kp PIPE     &kp RA(N8)   &kp RA(N9)   &kp RA(N7)      &trans        &kp LBRC    &kp RBRC    &kp LBKT     &kp RBKT    &kp LS(COMMA) &kp LS(DOT)

                                      &trans       &trans       &trans       &trans    &trans      &trans     &trans      &trans       &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };


        raise_layer {
            bindings = <
&bt BT_CLR                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &trans     &trans    &trans    &trans     &trans   &trans
&trans                                     &trans        &trans        &trans        &trans        &trans                        &kp PG_UP  &trans    &kp UP    &trans     &trans   &trans
&trans                                     &kp LALT      &kp LCTRL     &kp LSHIFT    &trans        &kp CLCK                      &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BACKSPACE
&studio_unlock                             &kp K_UNDO    &kp K_CUT      &kp K_COPY    &kp K_PASTE   &trans        &trans &trans   &trans     &trans    &trans    &trans    &trans   &trans

                                      &trans        &trans        &trans        &trans    &trans      &trans     &trans      &trans      &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
}

